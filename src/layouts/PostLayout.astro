---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date: Date;
  tags?: string[];
  type: 'poetry' | 'reflections' | 'essays';
  description?: string;
  readingTime?: number;
}

const { title, date, tags, type, description, readingTime } = Astro.props;

const formattedDate = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const backMap = {
  poetry: { href: '/poetry/', label: 'Poetry' },
  reflections: { href: '/reflections/', label: 'Reflections' },
  essays: { href: '/essays/', label: 'Essays' },
};
const backHref = backMap[type].href;
const backLabel = backMap[type].label;
---

<BaseLayout title={`${title} — Louis Adams`} description={description}>
  <a href={backHref} class="back-link">&larr; {backLabel}</a>
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <p class="post-meta">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        {readingTime && <span> &middot; {readingTime} min read</span>}
      </p>
      {tags && tags.length > 0 && (
        <div style="margin-top: 0.6rem;">
          {tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
      )}
    </header>
    <div class:list={[type === 'poetry' ? 'poem-body' : 'prose']}>
      <slot />
    </div>
  </article>

</BaseLayout>

<style>
  .post-cta {
    margin-top: 2.5rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  .post-cta a {
    color: var(--teal);
  }

  .post-cta a:hover {
    color: var(--teal-dim);
  }
</style>
