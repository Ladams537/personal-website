---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter(project => project.data.featured);
const experiments = projects.filter(project => !project.data.featured);
const writing = (await Promise.all(['poetry', 'reflections', 'essays'].map(async type => (await getCollection(type as 'poetry' | 'reflections' | 'essays')).map(entry => ({ ...entry, type }))))).flat().sort((a,b) => b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
---
<BaseLayout title="Louis Adams — Builder & poet">
  <section class="intro">
    <p class="eyebrow">Louis Adams / Portfolio</p>
    <h1>Building things.<br /><em>Finding the words.</em></h1>
    <div class="intro-bottom"><p>I'm Louis, a builder and poet. This is a home for the things I make, the ideas I follow, and the words I write along the way.</p><a href="mailto:louistadams3@gmail.com" class="text-link">Get in touch ↗</a></div>
  </section>
  <section id="work" class="portfolio-section">
    <div class="section-heading"><h2>Selected work</h2><span class="eyebrow">{String(featured.length).padStart(2, '0')} projects</span></div>
    <div class="project-list">{featured.map(project => <ProjectCard project={project} />)}</div>
  </section>
  {experiments.length > 0 && <section class="portfolio-section"><div class="section-heading"><h2>Small experiments</h2><a href="/work/" class="text-link">All work →</a></div><ul class="experiment-list">{experiments.map(project => <li><a href={`/projects/${project.slug}/`}><p class="eyebrow">{project.data.category}</p><h3>{project.data.title} ↗</h3><p>{project.data.summary}</p></a></li>)}</ul></section>}
  <section class="portfolio-section writing-section"><div class="section-heading"><h2>On the page</h2><a href="/writing/" class="text-link">All writing →</a></div><p class="section-description">Poetry, reflections, and essays. Another way of making sense of things.</p><ul class="writing-list">{writing.map(entry => <li><a href={`/${entry.type}/${entry.slug}/`}><span class="eyebrow">{entry.type}</span><h3>{entry.data.title}</h3><span aria-hidden="true">↗</span></a></li>)}</ul></section>
</BaseLayout>
