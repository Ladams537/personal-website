---
import { getCollection } from 'astro:content';
import Post from '../../components/Post.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('essays')).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
  const link = (e?: (typeof entries)[number]) => (e ? { href: `/essays/${e.slug}/`, title: e.data.title } : null);
  return entries.map((entry, i) => ({ params: { slug: entry.slug }, props: { entry, prev: link(entries[i - 1]), next: link(entries[i + 1]) } }));
}
const { entry, prev, next } = Astro.props;
const { Content } = await entry.render();
const data = entry.data as { title: string; date: Date; tags?: string[]; excerpt?: string; subtitle?: string };
---
<Post kind="essay" title={data.title} date={data.date} lede={data.excerpt ?? data.subtitle} tags={data.tags} prev={prev} next={next} body={entry.body}>
  <Content />
</Post>
