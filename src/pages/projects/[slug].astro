---
import { getCollection } from 'astro:content';
import Post from '../../components/Post.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  const link = (e?: (typeof entries)[number]) => (e ? { href: `/projects/${e.slug}/`, title: e.data.title } : null);
  return entries.map((entry, i) => ({ params: { slug: entry.slug }, props: { entry, prev: link(entries[i - 1]), next: link(entries[i + 1]) } }));
}
const { entry, prev, next } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;
---
<Post kind="project" title={d.title} date={d.date} eyebrow={d.category} lede={d.summary} status={d.status} tags={d.technologies} prev={prev} next={next} body={entry.body}>
  <Content />
</Post>
