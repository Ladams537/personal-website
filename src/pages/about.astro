---
// About: not a fixed bio. What stays the same, then who Louis is this season, with earlier
// seasons kept underneath. Poet's (paper) ground. Copy lives in src/content/{passages,seasons}.
import { existsSync } from 'node:fs';
import Layout from '../components/Layout.astro';
import { getPassage, getSeasons } from '../components/content';
import { fmtMonth } from '../components/format';

const constants = await getPassage('constants');
const contact = await getPassage('contact');
const seasons = (await getSeasons()).reverse();
const rendered = await Promise.all(seasons.map(async s => ({ s, ...(await s.render()) })));
const month = (d: Date) => fmtMonth(d.toISOString().slice(0, 10));
const span = (start: Date, end?: Date) => `${month(start)} – ${end ? month(end) : 'now'}`;
const portrait = existsSync('public/images/portrait.jpg');
---
<Layout title="About — Louis Adams" ground="paper" page="about">
  <main class="about">
    <header class="about-head">
      {portrait && <img src="/images/portrait.jpg" alt="Louis Adams" class="portrait" width="320" height="400" />}
      <div>
        <p class="mono dim">About</p>
        <h1>Louis <em>Adams</em></h1>
        <p class="intro">I'm Louis, a builder and poet. This is a home for the things I make, the ideas I follow, and the words I write along the way.</p>
      </div>
    </header>

    {constants && (
      <section class="block">
        <h2>{constants.entry.data.title}{constants.entry.data.draft && <span class="draft-badge">draft</span>}</h2>
        <div class="body"><constants.Content /></div>
      </section>
    )}

    <section class="versions" aria-label="Versions">
      <img src="/images/version-garden.jpg" alt="Louis laughing in a London garden, a leather jacket pulled over his head" loading="lazy" />
      <img src="/images/version-cafe.jpg" alt="Louis at a café table in the sun, chin on his hands" loading="lazy" />
      <img src="/images/version-gardens.jpg" alt="Louis in a white shirt and sunglasses above formal gardens" loading="lazy" />
    </section>

    {rendered.length > 0 && (
      <section class="block seasons">
        <h2>Seasons</h2>
        {rendered.map(({ s, Content }, i) => (
          <article class:list={['season', { now: i === 0 && !s.data.end }]}>
            <p class="mono when">{span(s.data.start, s.data.end)}{i === 0 && !s.data.end && <span class="now-tag">this season</span>}{s.data.draft && <span class="draft-badge">draft</span>}</p>
            <h3>{s.data.title}</h3>
            <p class="summary">{s.data.summary}</p>
            <div class="body"><Content /></div>
            {s.data.reflection && <p><a href={`/reflections/${s.data.reflection}/`} class="read">Read the reflection →</a></p>}
          </article>
        ))}
      </section>
    )}

    <section class="block">
      <h2>{contact?.entry.data.title ?? 'Get in touch'}{contact?.entry.data.draft && <span class="draft-badge">draft</span>}</h2>
      {contact && <div class="body"><contact.Content /></div>}
      <p class="mail"><a href="mailto:louistadams3@gmail.com">louistadams3@gmail.com ↗</a></p>
    </section>
  </main>

  <style is:global>
    .about { max-width: 820px; margin: 0 auto; padding: 120px clamp(16px, 4vw, 32px) 120px; }
    .about .dim { color: var(--paper-dim); }
    .about-head { display: flex; gap: 36px; align-items: flex-end; margin-bottom: 56px; }
    .portrait { width: 220px; height: auto; aspect-ratio: 4 / 5; object-fit: cover; filter: grayscale(.2); }
    .about h1 { font: 300 clamp(48px, 9vw, 104px)/.9 var(--serif); letter-spacing: -.035em; margin: 12px 0 18px; font-variation-settings: 'opsz' 144; }
    .about h1 em { color: var(--accent); }
    .intro { font: italic 300 21px/1.5 var(--serif); color: var(--paper-dim); max-width: 46ch; }
    .versions { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 8px 0 44px; }
    .versions img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; display: block; filter: saturate(.9); transition: filter .3s; }
    .versions img:hover { filter: none; }
    .block { padding: 36px 0; border-top: 1px solid color-mix(in oklab, var(--paper-fg) 14%, transparent); }
    .block h2 { font: 400 12px var(--mono); text-transform: uppercase; letter-spacing: .14em; color: var(--paper-dim); margin-bottom: 18px; }
    .body { font: 300 20px/1.65 var(--serif); max-width: 60ch; }
    .body p + p { margin-top: .9em; }
    .body ul { list-style: none; }
    .body li { padding: 8px 0; border-bottom: 1px dotted color-mix(in oklab, var(--paper-fg) 25%, transparent); }
    .season { padding: 22px 0 26px 22px; border-left: 2px solid color-mix(in oklab, var(--paper-fg) 15%, transparent); margin-bottom: 8px; }
    .season.now { border-left-color: var(--accent); }
    .season .when { font-size: 10px; color: var(--paper-dim); }
    .now-tag { color: var(--accent); margin-left: 10px; }
    .season h3 { font: 400 30px/1.15 var(--serif); margin: 6px 0 6px; }
    .summary { font: italic 300 19px/1.5 var(--serif); color: var(--paper-dim); margin-bottom: 10px; }
    .read, .mail a { color: var(--accent); font: 400 12px var(--mono); text-transform: uppercase; letter-spacing: .08em; text-decoration: none; }
    .read:hover, .mail a:hover { text-decoration: underline; }
    .mail { margin-top: 18px; }
    @media (max-width: 640px) { .about-head { flex-direction: column; align-items: flex-start; } .portrait { width: 60%; } }
  </style>
</Layout>
