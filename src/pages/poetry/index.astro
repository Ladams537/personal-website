---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPoems = (await getCollection('poetry'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Group by year
const byYear = new Map<number, typeof allPoems>();
for (const poem of allPoems) {
  const year = poem.data.date.getFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(poem);
}
---

<BaseLayout title="Poetry — Louis Adams">
  <h1 class="page-title">Poetry</h1>
  <p class="section-intro">Compressed wit with emotional weight.</p>

  {[...byYear.entries()].map(([year, poems]) => (
    <div>
      <h2 class="archive-year">{year}</h2>
      <ul class="archive-list">
        {poems.map(poem => (
          <li class="archive-item">
            <div>
              <a href={`/poetry/${poem.slug}/`}>{poem.data.title}</a>
              {poem.data.excerpt && <span class="excerpt">{poem.data.excerpt}</span>}
            </div>
            <time datetime={poem.data.date.toISOString()}>
              {poem.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit' })}
            </time>
          </li>
        ))}
      </ul>
    </div>
  ))}
</BaseLayout>
