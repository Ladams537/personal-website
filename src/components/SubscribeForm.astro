<div class="subscribe" id="subscribe">
  <h3 class="subscribe-heading">Stay in the loop</h3>
  <p class="subscribe-desc">Get notified when I publish new writing. Choose what interests you.</p>

  <form class="subscribe-form" id="subscribe-form">
    <!-- Honeypot -->
    <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off" />

    <div class="subscribe-interests" role="group" aria-label="Content types">
      <button type="button" class="interest-toggle" data-interest="all" aria-pressed="true">All</button>
      <button type="button" class="interest-toggle" data-interest="poetry" aria-pressed="true">Poetry</button>
      <button type="button" class="interest-toggle" data-interest="reflections" aria-pressed="true">Reflections</button>
      <button type="button" class="interest-toggle" data-interest="essays" aria-pressed="true">Essays</button>
    </div>

    <div class="subscribe-row">
      <input
        type="email"
        name="email"
        placeholder="your@email.com"
        required
        autocomplete="email"
        class="subscribe-input"
      />
      <button type="submit" class="subscribe-btn">Subscribe</button>
    </div>

    <p class="subscribe-status" id="subscribe-status" aria-live="polite"></p>
  </form>
</div>

<script>
  const form = document.getElementById('subscribe-form') as HTMLFormElement;
  const status = document.getElementById('subscribe-status')!;
  const toggles = form.querySelectorAll<HTMLButtonElement>('.interest-toggle');
  const allToggle = form.querySelector<HTMLButtonElement>('[data-interest="all"]')!;
  const specificToggles = Array.from(toggles).filter(t => t.dataset.interest !== 'all');

  function isPressed(btn: HTMLButtonElement) {
    return btn.getAttribute('aria-pressed') === 'true';
  }

  function setPressed(btn: HTMLButtonElement, pressed: boolean) {
    btn.setAttribute('aria-pressed', String(pressed));
  }

  function syncAll() {
    const allSelected = specificToggles.every(t => isPressed(t));
    setPressed(allToggle, allSelected);
  }

  allToggle.addEventListener('click', () => {
    const next = !isPressed(allToggle);
    setPressed(allToggle, next);
    specificToggles.forEach(t => setPressed(t, next));
  });

  specificToggles.forEach(toggle => {
    toggle.addEventListener('click', () => {
      setPressed(toggle, !isPressed(toggle));
      syncAll();
    });
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (form.querySelector('[name="email"]') as HTMLInputElement).value;
    const website = (form.querySelector('[name="website"]') as HTMLInputElement).value;
    const interests = specificToggles.filter(t => isPressed(t)).map(t => t.dataset.interest!);

    if (!interests.length) {
      status.textContent = 'Please select at least one content type.';
      status.className = 'subscribe-status error';
      return;
    }

    const btn = form.querySelector('.subscribe-btn') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Subscribing...';
    status.textContent = '';
    status.className = 'subscribe-status';

    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, interests, website }),
      });
      const data = await res.json();

      if (data.success) {
        form.innerHTML = '<p class="subscribe-thanks">You\u2019re in. Thanks for subscribing.</p>';
      } else {
        status.textContent = data.error || 'Something went wrong.';
        status.className = 'subscribe-status error';
        btn.disabled = false;
        btn.textContent = 'Subscribe';
      }
    } catch {
      status.textContent = 'Network error. Please try again.';
      status.className = 'subscribe-status error';
      btn.disabled = false;
      btn.textContent = 'Subscribe';
    }
  });
</script>

<style>
