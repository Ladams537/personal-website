    padding: 2rem 0 2.5rem;
    margin-bottom: 2rem;
  }

  .subscribe-heading {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 0.4rem;
  }

  .subscribe-desc {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
    margin-bottom: 1.2rem;
  }

  .subscribe-interests {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .interest-toggle {
    font-family: var(--font-ui);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .interest-toggle[aria-pressed="true"] {
    border-color: var(--teal-dim);
    color: var(--teal);
    background: var(--teal-glow);
  }

  .interest-toggle:hover {
    border-color: var(--teal-dim);
    color: var(--teal);
  }

  .subscribe-row {
    display: flex;
    gap: 0.6rem;
  }

  .subscribe-input {
    flex: 1;
    font-family: var(--font-body);
    font-size: 0.85rem;
    padding: 0.55rem 0.8rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--text);
    outline: none;
    transition: border-color 0.2s ease;
  }

  .subscribe-input::placeholder {
    color: var(--text-muted);
  }

  .subscribe-input:focus {
    border-color: var(--teal-dim);
  }

  .subscribe-btn {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.55rem 1.2rem;
    background: var(--teal);
    color: var(--bg);
    border: none;
    border-radius: 3px;
    cursor: pointer;
    transition: background 0.2s ease;
    white-space: nowrap;
  }

  .subscribe-btn:hover {
    background: var(--teal-dim);
  }

  .subscribe-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .subscribe-status {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    margin-top: 0.6rem;
    min-height: 1.2em;
  }

  .subscribe-status.error {
    color: #e06060;
  }

  .subscribe-thanks {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--teal);
    font-style: italic;
  }

  @media (max-width: 640px) {
    .subscribe-row {
      flex-direction: column;
    }
  }
</style>
